# EMRIX storefront. Copy to frontend/.env.local for local development. On your host (e.g. Vercel),
# add the same variables in its environment settings. They're needed at build time too: shop pages
# are pre-rendered from the backend's data, so deploy the backend first.

# The backend's address (no trailing slash), e.g. https://api.emrix.com
API_URL=http://localhost:3300

# The same long random secret as INTERNAL_API_KEY in the backend and admin panel.
INTERNAL_API_KEY=
